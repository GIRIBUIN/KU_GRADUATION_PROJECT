<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_widget_header_title"
            android:textColor="@color/widget_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            tools:text="9월 11일 (목)" />
        <include layout="@layout/widget_add_button" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_divider" />

    <!-- 목록 영역이 남은 높이를 차지하고, 페이지 버튼은 목록 개수와 관계없이 하단에 유지된다. -->
    <LinearLayout
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/task_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/task_checkbox_0"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/schedule_widget_complete_task"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_checkbox_unchecked" />

            <TextView
                android:id="@+id/task_accent_0"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_accent_bar" />

            <TextView
                android:id="@+id/task_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="42dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="09:00" />

            <TextView
                android:id="@+id/task_title_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"
                tools:text="운영체제 강의 듣기" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_divider_0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/widget_divider"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/task_checkbox_1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/schedule_widget_complete_task"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_checkbox_unchecked" />

            <TextView
                android:id="@+id/task_accent_1"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_accent_bar" />

            <TextView
                android:id="@+id/task_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="42dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="13:00" />

            <TextView
                android:id="@+id/task_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"
                tools:text="헬스장 가기" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_divider_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/widget_divider"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/task_checkbox_2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/schedule_widget_complete_task"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_checkbox_unchecked" />

            <TextView
                android:id="@+id/task_accent_2"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_accent_bar" />

            <TextView
                android:id="@+id/task_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="42dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="18:00" />

            <TextView
                android:id="@+id/task_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"
                tools:text="팀플 회의" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/widget_empty_message"
            android:textColor="@color/widget_muted"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pagination"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal">
        <Button
            android:id="@+id/widget_previous"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:text="@string/widget_previous" />
        <TextView
            android:id="@+id/widget_page"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/widget_muted" />
        <Button
            android:id="@+id/widget_next"
            android:layout_width="72dp"
            android:layout_height="40dp"
            android:text="@string/widget_next" />
    </LinearLayout>
</LinearLayout>
