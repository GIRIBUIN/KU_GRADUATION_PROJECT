<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_widget_header_title"
            android:textColor="@color/widget_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            tools:text="9월 11일 (목)" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/task_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/task_checkbox_0"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/schedule_widget_complete_task"
            android:src="@drawable/widget_checkbox_unchecked" />

        <TextView
            android:id="@+id/task_accent_0"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_accent_bar" />

        <TextView
            android:id="@+id/task_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="42dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="09:00" />

        <TextView
            android:id="@+id/task_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            tools:text="운영체제 강의 듣기" />

        <TextView
            android:id="@+id/task_due_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="D-day" />
    </LinearLayout>

    <TextView
        android:id="@+id/task_divider_0"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/task_checkbox_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/schedule_widget_complete_task"
            android:src="@drawable/widget_checkbox_unchecked" />

        <TextView
            android:id="@+id/task_accent_1"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_accent_bar" />

        <TextView
            android:id="@+id/task_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="42dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="13:00" />

        <TextView
            android:id="@+id/task_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            tools:text="헬스장 가기" />

        <TextView
            android:id="@+id/task_due_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="D-day" />
    </LinearLayout>

    <TextView
        android:id="@+id/task_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/task_checkbox_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/schedule_widget_complete_task"
            android:src="@drawable/widget_checkbox_unchecked" />

        <TextView
            android:id="@+id/task_accent_2"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_accent_bar" />

        <TextView
            android:id="@+id/task_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="42dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="18:00" />

        <TextView
            android:id="@+id/task_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            tools:text="팀플 회의" />

        <TextView
            android:id="@+id/task_due_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="D-day" />
    </LinearLayout>
</LinearLayout>
