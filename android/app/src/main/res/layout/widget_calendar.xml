<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_calendar_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/calendar_widget_title"
        android:textColor="@color/widget_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_monday" />
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_tuesday" />
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_wednesday" />
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_thursday" />
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_friday" />
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_saturday" />
        <TextView style="@style/WidgetCalendarWeekday" android:text="@string/widget_weekday_sunday" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:id="@+id/widget_calendar_weeks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
