<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="2dp">
    <ImageView android:id="@+id/widget_card_background" android:layout_width="match_parent"
        android:layout_height="match_parent" android:src="@drawable/widget_frame" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/workspace_surface" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp"
        android:contentDescription="일정 목록 확대하기">
        <LinearLayout android:id="@+id/workspace_header" android:layout_width="match_parent" android:layout_height="18dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/workspace_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="오늘 할 일정" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/workspace_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:textSize="10sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/workspace_date" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workspace_rows" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" />
        <TextView android:id="@+id/workspace_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/workspace_more" android:layout_width="match_parent" android:layout_height="12dp"
            android:gravity="end|center_vertical" android:textSize="9sp" android:includeFontPadding="false" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
