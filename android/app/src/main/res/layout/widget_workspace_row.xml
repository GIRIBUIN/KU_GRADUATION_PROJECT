<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/workspace_row_check" android:layout_width="42dp" android:layout_height="48dp"
        android:padding="10dp" android:src="@drawable/widget_checkbox_unchecked" android:contentDescription="완료 상태 전환" />
    <LinearLayout android:id="@+id/workspace_row_body" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/workspace_row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/workspace_row_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
