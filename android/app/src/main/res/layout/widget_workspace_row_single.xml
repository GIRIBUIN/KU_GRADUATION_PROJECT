<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workspace_row_body" android:layout_width="match_parent" android:layout_height="26dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/workspace_row_check" android:layout_width="22dp" android:layout_height="22dp"
        android:padding="4dp" android:src="@drawable/widget_checkbox_unchecked" android:importantForAccessibility="no" />
    <TextView android:id="@+id/workspace_row_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/workspace_row_detail" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
