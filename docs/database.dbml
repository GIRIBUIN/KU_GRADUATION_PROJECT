Project KUTODO {
  database_type: "SQLite"
  Note: "Active Drift schema v7, 2026-11-15. DateTimeColumn stores Unix seconds. Legacy migration backups are not active tables. Source: lib/data/local/app_database.dart"
}

Table tasks {
  id text [not null, pk]
  title text [not null]
  due_date integer [note: "Unix seconds / Drift DateTimeColumn"]
  priority text
  memo text
  list_id text [not null, ref: > task_lists.id, default: 'kutodo:inbox']
  sort_order integer [not null, default: 0]
  completed_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  deleted_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  created_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (deleted_at, completed_at, sort_order, created_at) [name: "tasks_active_order"]
    list_id [name: "tasks_list"]
    due_date [name: "tasks_due"]
  }
  Note: "State/origin are projected in the mapper; no physical status/origin or parent_task_id column. CHECK priority is high/medium/low or NULL."
}

Table sub_tasks {
  id text [not null, pk]
  task_id text [not null, ref: > tasks.id]
  title text [not null]
  position integer [not null, default: 0]
  completed_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  deleted_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  created_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (task_id, deleted_at, position) [name: "subtasks_parent"]
  }
}

Table tags {
  id text [not null, pk]
  name text [not null]
  color text [not null]
  sort_order integer [not null, default: 0]
  deleted_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  created_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
}

Table task_lists {
  id text [not null, pk]
  name text [not null]
  color text
  icon text
  folder_id text [ref: > folder_groups.id]
  sort_order integer [not null, default: 0]
  deleted_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  created_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (folder_id, deleted_at, sort_order) [name: "lists_folder"]
  }
  Note: "Lists, not folder groups. CHECK kutodo:inbox has NULL folder_id and NULL deleted_at. UI uses visibility, not archive/restore menus."
}

Table folder_groups {
  id text [not null, pk]
  name text [not null]
  sort_order integer [not null, default: 0]
  deleted_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  created_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
}

Table task_tags {
  task_id text [not null, ref: > tasks.id]
  tag_id text [not null, ref: > tags.id]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  deleted_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (tag_id, deleted_at) [name: "task_tags_tag"]
    (task_id, tag_id) [pk]
  }
}

Table ecampus_courses {
  id text [not null, pk]
  source_scope_id text [not null]
  external_course_key text
  name text [not null]
  tag_id text [ref: > tags.id]
  list_id text [ref: > task_lists.id]
  last_observed_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (source_scope_id, external_course_key) [unique]
  }
}

Table ecampus_items {
  id text [not null, pk]
  source_scope_id text [not null]
  course_id text [ref: > ecampus_courses.id]
  external_key text
  source_title text [not null]
  source_course text
  source_type text
  source_start_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  source_end_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  task_id text [unique, ref: > tasks.id]
  import_state text [not null]
  first_observed_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  last_observed_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (source_scope_id, external_key) [unique]
  }
  Note: "CHECK imported requires task_id; ignored/unreviewed require NULL task_id. Exclusion is stored here, not a Tasks row."
}

Table import_sessions {
  id text [not null, pk]
  provider text [not null, default: 'ecampus']
  input_method text [not null, default: 'webview_html']
  source_scope_id text [not null]
  started_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  ended_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  state text [not null]
  applied_count integer [not null, default: 0]
  Note: "Committed apply records, not the WebView login session or full failed/cancelled-session audit."
}

Table task_reminders {
  id text [not null, unique]
  task_id text [not null, pk, ref: > tasks.id]
  enabled boolean [not null]
  offset_minutes integer [not null]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Note: "CHECK offset_minutes >= 0. Reminder rule, separate from OS schedule."
}

Table local_notification_schedules {
  task_id text [not null, pk, ref: > tasks.id]
  platform_notification_id integer [unique]
  scheduled_at integer [note: "Unix seconds / Drift DateTimeColumn"]
  last_error text
}

Table app_settings {
  key text [not null, pk]
  value text [not null]
  updated_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
}

Table migration_issues {
  id integer [not null, pk, increment]
  entity_id text [not null]
  reason text [not null]
  legacy_data text [not null]
}

Table deleted_entities {
  entity_type text [not null]
  entity_id text [not null]
  deleted_at integer [not null, note: "Unix seconds / Drift DateTimeColumn"]
  Indexes {
    (entity_type, entity_id) [pk]
  }
}
